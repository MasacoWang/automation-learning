{
  "manifest_version": 3,
  "name": "TA Hub Dashboard",
  "version": "1.0.0",
  "description": "Summarizes feedback status and candidate pipeline from TA Hub (CareerHub)",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://careerhub.microsoft.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://careerhub.microsoft.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
