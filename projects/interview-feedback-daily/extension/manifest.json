{
  "manifest_version": 3,
  "name": "Interview Feedback Daily",
  "version": "1.1.0",
  "description": "Extracts interview feedback from TA Hub and shows daily summary with Teams/Email sharing",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["https://careerhub.microsoft.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://careerhub.microsoft.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
